{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "sourceMap": true,

    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "noImplicitAny": false
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
