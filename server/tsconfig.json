{
  "compilerOptions": {
    /* Diretórios */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Ambiente Node */
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": ["node"],

    /* Compatibilidade */
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Debug */
    "sourceMap": true,

    /* Tipagem */
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* Correção do problema */
    "verbatimModuleSyntax": false
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}